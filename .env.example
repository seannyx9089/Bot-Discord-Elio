# Wajib
DISCORD_TOKEN=isi_token_bot_discord

# MySQL Railway: biasanya otomatis tersedia jika service MySQL di-link ke bot
MYSQLHOST=
MYSQLPORT=3306
MYSQLUSER=
MYSQLPASSWORD=
MYSQLDATABASE=
# Alternatif jika Railway menyediakan satu URL database
DATABASE_URL=
GUILD_ID=123456789012345678

# ID channel tempat bot mengirim status toko
STORE_CHANNEL_ID=123456789012345678

# ID channel untuk menerima rating ticket
RATING_CHANNEL_ID=123456789012345678

# Ticket otomatis ditutup setelah tidak aktif selama jumlah jam ini
AUTO_CLOSE_HOURS=72

# ID channel welcome dan goodbye
WELCOME_CHANNEL_ID=123456789012345678
GOODBYE_CHANNEL_ID=123456789012345678

# ID kategori Discord untuk channel ticket
TICKET_CATEGORY_ID=123456789012345678

# ID role staff yang dapat melihat dan menutup ticket
STAFF_ROLE_ID=123456789012345678

# Opsional: URL gambar welcome/goodbye langsung (PNG/JPG/GIF)
WELCOME_IMAGE_URL=
GOODBYE_IMAGE_URL=

# Opsional; Railway dapat menggunakan default ini
DATA_FILE=data/store.json
